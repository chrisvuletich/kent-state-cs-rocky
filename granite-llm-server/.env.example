# Internal Rocky model bridge. This service should not be internet-facing.
ROCKY_APP_ENV=development
ROCKY_GRANITE_HOST=127.0.0.1
ROCKY_GRANITE_PORT=5002
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
ROCKY_OLLAMA_TIMEOUT_SECONDS=150
ROCKY_OLLAMA_READY_TIMEOUT_SECONDS=2
ROCKY_MAX_OUTPUT_TOKENS=2048
# Private request and decoded-image limits.
ROCKY_GRANITE_MAX_REQUEST_BYTES=10485760
ROCKY_MAX_IMAGES_PER_REQUEST=4
ROCKY_MAX_IMAGE_BYTES=4194304
ROCKY_MAX_IMAGE_TOTAL_BYTES=6291456
ROCKY_MAX_IMAGE_PIXELS=20000000
ROCKY_MAX_IMAGE_TOTAL_PIXELS=40000000
# Disabled-by-default rollout gates for streaming and image input.
ROCKY_ENABLE_STREAMING=false
ROCKY_ENABLE_IMAGE_INPUT=false
ROCKY_GRANITE_TOKEN=replace-with-a-long-random-granite-token
ROCKY_GRANITE_MAX_CONCURRENT=1
ROCKY_GRANITE_QUEUE_WAIT_SECONDS=1

# Private hardware snapshot endpoint. Production requires a long random token.
ROCKY_HARDWARE_METRICS_TOKEN=
ROCKY_HARDWARE_COMMAND_TIMEOUT_SECONDS=3
ROCKY_HARDWARE_HOST=127.0.0.1
ROCKY_HARDWARE_PORT=5010
