# Root convenience variables used by helper scripts.
# This file is optional and can override service-level .env values.

# development | testing | production
ROCKY_APP_ENV=development
PUBLIC_APP_ENV=development

# Local development uses preview login and enables the DB test view.
PUBLIC_ENABLE_MICROSOFT_OAUTH=false
PUBLIC_ENABLE_DBTEST=true
PUBLIC_MICROSOFT_CLIENT_ID=
PUBLIC_MICROSOFT_TENANT_ID=

# Backend API bind settings.
ROCKY_API_HOST=127.0.0.1
ROCKY_API_PORT=5001
PUBLIC_API_BASE_URL=http://127.0.0.1:5001

# Local development database shared by the backend and chat API.
ROCKY_DB_BACKEND=mongita
ROCKY_DB_NAME=rocky_db
ROCKY_MONGITA_PATH=.rocky-data/mongita

# Internal model bridge and public chat API binds.
ROCKY_GRANITE_HOST=127.0.0.1
ROCKY_GRANITE_PORT=5002
ROCKY_CHAT_API_HOST=127.0.0.1
ROCKY_CHAT_API_PORT=5003
ROCKY_GRANITE_URL=http://127.0.0.1:5002/generate
ROCKY_GRANITE_READY_URL=http://127.0.0.1:5002/ready
ROCKY_CHAT_API_URL=http://127.0.0.1:5003/v1/responses

# The public model is the model identifier students send to the API.
ROCKY_PUBLIC_MODEL=gemma4:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Use one long random value for backend/frontend hidden web-chat keys.
ROCKY_HIDDEN_API_KEY_SECRET=replace-with-a-long-random-secret
ROCKY_SESSION_SECRET=replace-with-a-different-long-random-secret
ROCKY_INTERNAL_PROXY_SECRET=replace-with-another-long-random-secret
ROCKY_GRANITE_TOKEN=replace-with-a-fourth-long-random-secret

# Inner requests time out before outer service layers.
ROCKY_OLLAMA_TIMEOUT_SECONDS=150
ROCKY_GRANITE_TIMEOUT_SECONDS=170
ROCKY_MAX_OUTPUT_TOKENS=2048
ROCKY_MAX_CONTEXT_CHARS=60000
ROCKY_GRANITE_MAX_CONCURRENT=1
ROCKY_GRANITE_QUEUE_WAIT_SECONDS=1
# Local development may use false. Production must set this to true.
ROCKY_REQUIRE_REQUEST_LOGGING=false

# Optional bounded hardware history. For production, point this URL at the
# metrics-only service running on Granite and use the same long random token.
ROCKY_HARDWARE_TELEMETRY_ENABLED=false
ROCKY_HARDWARE_METRICS_URL=http://127.0.0.1:5002/hardware
ROCKY_HARDWARE_METRICS_TOKEN=
ROCKY_HARDWARE_SAMPLE_INTERVAL_SECONDS=30
ROCKY_HARDWARE_METRICS_TIMEOUT_SECONDS=5
ROCKY_HARDWARE_RETENTION_DAYS=90

# Frontend bind settings used by dev and preview launchers.
ROCKY_WEB_HOST=127.0.0.1
ROCKY_WEB_PORT=5000

# Comma-separated hostnames allowed by Vite during development.
ROCKY_ALLOWED_HOSTS=localhost,127.0.0.1
