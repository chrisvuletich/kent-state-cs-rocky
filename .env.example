# Root convenience variables used by helper scripts.
# This file is optional and can override service-level .env values.

# development | testing | production
ROCKY_APP_ENV=development

# Backend API bind settings.
ROCKY_API_HOST=127.0.0.1
ROCKY_API_PORT=5001

# Granite inference service bind settings for local development.
ROCKY_GRANITE_HOST=127.0.0.1
ROCKY_GRANITE_PORT=5002

# Rocky chat API bridge bind settings for local development.
ROCKY_CHAT_API_HOST=127.0.0.1
ROCKY_CHAT_API_PORT=5003

# Chat bridge / Granite inference defaults.
ROCKY_CHAT_API_KEY=SOME_API_KEY
ROCKY_CHAT_MODEL=qwen3:0.6b

# Optional: set this to a deployed Granite endpoint to skip the local Granite process in run-dev.py.
# Example: ROCKY_GRANITE_URL=https://granite.cs.kent.edu/generate

# Frontend bind settings used by dev and preview launchers.
ROCKY_WEB_HOST=127.0.0.1
ROCKY_WEB_PORT=5000

# Comma-separated hostnames allowed by Vite during development.
ROCKY_ALLOWED_HOSTS=localhost,127.0.0.1
