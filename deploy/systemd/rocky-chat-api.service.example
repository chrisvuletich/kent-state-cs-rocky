[Unit]
Description=Rocky chat API
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/api-rocky
EnvironmentFile=/etc/rocky/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/gunicorn --worker-class gthread --workers 2 --threads 8 --timeout 330 --bind 127.0.0.1:5003 --access-logfile - --error-logfile - api:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
