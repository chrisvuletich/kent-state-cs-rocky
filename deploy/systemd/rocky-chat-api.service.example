[Unit]
Description=Rocky chat API
After=network-online.target rocky-granite.service
Wants=network-online.target rocky-granite.service

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/api-rocky
EnvironmentFile=/etc/rocky/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=ROCKY_GRANITE_URL=http://127.0.0.1:5002/generate
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:5003 --access-logfile - --error-logfile - api:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
