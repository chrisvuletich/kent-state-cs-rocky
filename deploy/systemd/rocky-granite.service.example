[Unit]
Description=Rocky Granite/Ollama bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/granite-llm-server
EnvironmentFile=/etc/rocky/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/gunicorn --workers 1 --timeout 165 --bind 127.0.0.1:5002 --access-logfile - --error-logfile - app.main:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
