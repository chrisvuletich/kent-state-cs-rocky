[Unit]
Description=Granite Ollama bridge for Rocky
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/granite-llm-server
EnvironmentFile=/etc/rocky/granite.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/gunicorn --worker-class gthread --workers 1 --threads 4 --timeout 165 --bind {{GRANITE_BIND_IP}}:5002 --access-logfile - --error-logfile - app.main:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
