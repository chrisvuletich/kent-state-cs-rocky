[Unit]
Description=Rocky Flask backend API
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/rocky-backend
EnvironmentFile=/etc/rocky/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5001 --access-logfile - --error-logfile - main:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
