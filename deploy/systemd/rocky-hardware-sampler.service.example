[Unit]
Description=Rocky Granite hardware telemetry sampler
After=network-online.target mongod.service
Wants=network-online.target mongod.service

[Service]
Type=simple
User={{ROCKY_USER}}
Group={{ROCKY_GROUP}}
WorkingDirectory={{ROCKY_APP_DIR}}/rocky-backend
EnvironmentFile=/etc/rocky/backend.env
Environment=PYTHONUNBUFFERED=1
ExecStart={{ROCKY_APP_DIR}}/.venv/bin/python sample_hardware.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
