# Backend runtime environment configuration.

# development | testing | production
ROCKY_APP_ENV=development

# Backend API bind host and port.
ROCKY_API_HOST=127.0.0.1
ROCKY_API_PORT=5001

# Enable debug mode locally only.
ROCKY_DEBUG=true

# Set to mongodb for production deployments.
# Use mongita only for local development/testing fallback.
ROCKY_DB_BACKEND=mongita

# Required when ROCKY_APP_ENV=production.
# Example format: mongodb+srv://user:password@cluster/db?retryWrites=true&w=majority
ROCKY_MONGODB_URI=

# Database name for MongoDB or Mongita.
ROCKY_DB_NAME=rocky_db

# Relative paths resolve from the repository root. Shared with api-rocky.
ROCKY_MONGITA_PATH=.rocky-data/mongita

# Chat API audit logging. Local development may use false; production must use true.
ROCKY_REQUIRE_REQUEST_LOGGING=false

# Required for the built-in web chat's per-user keys.
ROCKY_HIDDEN_API_KEY_SECRET=replace-with-a-long-random-hidden-key-secret

# Required in production and whenever SvelteKit reaches this service through a
# non-loopback connection. Secretless development trusts loopback requests only.
ROCKY_INTERNAL_PROXY_SECRET=replace-with-a-long-random-internal-proxy-secret

# Disable in production to avoid exposing data inspector.
ROCKY_ENABLE_DB_INSPECTOR=true

# Enable Microsoft OAuth in development when set to true.
# Production always enables Microsoft OAuth.
# Testing always disables Microsoft OAuth.
ROCKY_ENABLE_MICROSOFT_OAUTH=false

# Optional bounded hardware history. The metrics URL must run on Granite if
# Granite's GPU/system hardware is what should be measured.
ROCKY_HARDWARE_TELEMETRY_ENABLED=false
ROCKY_HARDWARE_METRICS_URL=http://127.0.0.1:5002/hardware
ROCKY_HARDWARE_METRICS_TOKEN=
ROCKY_HARDWARE_SAMPLE_INTERVAL_SECONDS=30
ROCKY_HARDWARE_METRICS_TIMEOUT_SECONDS=5
ROCKY_HARDWARE_RETENTION_DAYS=90

# Permanent request telemetry is retained indefinitely by default. A positive
# value documents a future policy but does not schedule deletion automatically.
ROCKY_REQUEST_RETENTION_DAYS=0
