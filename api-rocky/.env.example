# Rocky chat API configuration.
ROCKY_APP_ENV=development
ROCKY_CHAT_API_HOST=127.0.0.1
ROCKY_CHAT_API_PORT=5003
ROCKY_GRANITE_URL=http://127.0.0.1:5002/generate
ROCKY_GRANITE_READY_URL=http://127.0.0.1:5002/ready
ROCKY_GRANITE_TOKEN=replace-with-a-long-random-granite-token
ROCKY_GRANITE_TIMEOUT_SECONDS=170
ROCKY_READINESS_TIMEOUT_SECONDS=2
ROCKY_MAX_REQUEST_BYTES=262144
ROCKY_MAX_OUTPUT_TOKENS=2048
ROCKY_MAX_CONTEXT_CHARS=60000
# Per-key request policy for the student-facing endpoints.
ROCKY_RESPONSES_RATE_LIMIT_PER_MINUTE=10
ROCKY_MODELS_RATE_LIMIT_PER_MINUTE=120
# Local development may use false. Production must use true so inference cannot
# occur without an audit record.
ROCKY_REQUIRE_REQUEST_LOGGING=false

# Local development storage shared with rocky-backend.
ROCKY_DB_BACKEND=mongita
ROCKY_MONGODB_URI=
ROCKY_DB_NAME=rocky_db
ROCKY_MONGITA_PATH=.rocky-data/mongita
ROCKY_MONGODB_CONNECT_ATTEMPTS=10
ROCKY_MONGODB_RETRY_SECONDS=2
ROCKY_TELEMETRY_ENABLED=true

# Student-facing identifier and internal Ollama model.
ROCKY_PUBLIC_MODEL=gemma4:latest
OLLAMA_MODEL=gemma4:latest
ROCKY_INTERNAL_PROXY_SECRET=replace-with-a-long-random-internal-proxy-secret

# Optional only when a single service key is used instead of per-user web keys.
ROCKY_CHAT_API_KEY=
